# =============================================
# R & M Collection — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit the real .env to Git.
# =============================================

# Server
PORT=3001
NODE_ENV=production

# ── Option A: Railway MySQL connection URL (preferred) ──
# Railway auto-sets this when you add a MySQL plugin.
# DATABASE_URL=mysql://user:password@host:port/database

# ── Option B: Individual MySQL vars ──
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=mwsfhEhtqWSdeWcTsbGCOlywdygePYej
DB_NAME=railway
# Set DB_SSL=false only if your Railway MySQL does not use SSL
# DB_SSL=false

# JWT
JWT_SECRET=7f3c9b1a6d4e2f8c5a0b9e3d1c6f4a8b2e7d9c1f5a3b6e8d4c2f0a9b7e5d3c1a
JWT_EXPIRES_IN=7d

# Admin seed (used only by create-admin.js, not at runtime)
ADMIN_EMAIL=admin@rmcollection.com
ADMIN_PASSWORD=Admin@12345

# Email (Gmail App Password — NOT your real Gmail password)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# CORS — set this to your Netlify frontend URL
ALLOWED_ORIGIN=https://your-app.netlify.app

# Frontend URL — used in email links
FRONTEND_URL=https://your-app.netlify.app
